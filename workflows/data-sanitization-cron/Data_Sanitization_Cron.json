            "action": "={{ $json.action }}",
            "target": "={{ $json.target }}",
            "reason": "={{ $json.reason }}",
            "actor": "system",
            "approved_by": "",
            "outcome": "failed",
            "detail": "={{ $json.detail }}"
          }
        },
        "options": {}
      },
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "REPLACE_SHEETS_CRED",
          "name": "Google Sheets (ledger)"
        }
      }
    }
  ],
