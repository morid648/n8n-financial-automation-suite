{
  "name": "Macro_Thematic_Ideation",
  "meta": {
    "description": "RAG ideation over macro/sector data. Vector store = Supabase/pgvector (T1.1). Returns grounded research themes. Corrected per PRD 3.1-3.5."
  },
  "nodes": [
    {
      "id": "n-ingest",
      "name": "Ingest_API_Payload",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        -1180,
        0
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "macro-ideation/intake",
        "responseMode": "responseNode",
        "options": {}
      },
      "webhookId": "macro-ideation-intake"
    },
    {
      "id": "n-config",
      "name": "Workflow_Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        -980,
        0
      ],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "c1",
              "name": "enabled",
              "value": true,
              "type": "boolean"
            },
            {
              "id": "c2",
              "name": "model",
              "value": "claude-sonnet-5",
              "type": "string"
            },
            {
              "id": "c3",
              "name": "max_tokens",
              "value": 1200,
              "type": "number"
            },
            {
              "id": "c4",
              "name": "top_k",
              "value": 8,
              "type": "number"
            },
            {
              "id": "c5",
              "name": "chunk_size",
              "value": 400,
              "type": "number"
            },
            {
              "id": "c6",
              "name": "chunk_overlap",
              "value": 40,
              "type": "number"
            }
          ]
        },
        "includeOtherFields": true,
        "options": {}
      }
    },
    {
      "id": "n-gate",
      "name": "Enabled_Gate",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        -780,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "version": 2,
            "typeValidation": "strict",
            "caseSensitive": true
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "g1",
              "leftValue": "={{ $json.enabled }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "n-bridge",
      "name": "Bridge_Agent_Input",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        -560,
        -120
      ],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "b1",
              "name": "text",
              "value": "={{ $json.body.text || $json.body.content || $json.body.message }}",
              "type": "string"
            },
            {
              "id": "b2",
              "name": "sessionId",
              "value": "={{ $json.body.sessionId || $json.body.id || $execution.id }}",
              "type": "string"
            },
            {
              "id": "b3",
              "name": "source_ref",
              "value": "={{ $json.body.source_ref || $json.body.id || $execution.id }}",
              "type": "string"
            }
          ]
        },
        "includeOtherFields": false,
        "options": {}
      },
      "notes": "PRD 3.3 fix: gives NLP_Financial_Agent a real main-path input."
    },
    {
      "id": "n-split",
      "name": "Text_Chunking_Engine",
      "type": "@n8n/n8n-nodes-langchain.textSplitterCharacterTextSplitter",
      "typeVersion": 1,
      "position": [
        -560,
        300
      ],
      "parameters": {
        "chunkSize": "={{ $('Workflow_Config').item.json.chunk_size }}",
        "chunkOverlap": "={{ $('Workflow_Config').item.json.chunk_overlap }}",
        "options": {}
      }
    },
    {
      "id": "n-loader",
      "name": "Document_Loader",
      "type": "@n8n/n8n-nodes-langchain.documentDefaultDataLoader",
      "typeVersion": 1.1,
      "position": [
        -380,
        300
      ],
      "parameters": {
        "jsonMode": "expressionData",
        "jsonData": "={{ $('Bridge_Agent_Input').item.json.text }}",
        "options": {
          "metadata": {
            "metadataValues": [
              {
                "name": "source_ref",
                "value": "={{ $('Bridge_Agent_Input').item.json.source_ref }}"
              }
            ]
          }
        }
      }
    },
    {
      "id": "n-embed",
      "name": "Cohere_Vector_Embeddings",
      "type": "@n8n/n8n-nodes-langchain.embeddingsCohere",
      "typeVersion": 1,
      "position": [
        -180,
        420
      ],
      "parameters": {
        "modelName": "embed-english-v3.0"
      },
      "credentials": {
        "cohereApi": {
          "id": "REPLACE_COHERE_CRED",
          "name": "Cohere account"
        }
      }
    },
    {
      "id": "n-vinsert",
      "name": "Vector_DB_Insert",
      "type": "@n8n/n8n-nodes-langchain.vectorStoreSupabase",
      "typeVersion": 1.1,
      "position": [
        -180,
        180
      ],
      "parameters": {
        "mode": "insert",
        "tableName": {
          "__rl": true,
          "value": "macro_documents",
          "mode": "list"
        },
        "options": {
          "queryName": "match_documents"
        }
      },
      "credentials": {
        "supabaseApi": {
          "id": "REPLACE_SUPABASE_CRED",
          "name": "Supabase account"
        }
      }
    },
    {
      "id": "n-vretrieve",
      "name": "Vector_Retrieval_Tool",
      "type": "@n8n/n8n-nodes-langchain.vectorStoreSupabase",
      "typeVersion": 1.1,
      "position": [
        -360,
        -360
      ],
      "parameters": {
        "mode": "retrieve-as-tool",
        "toolName": "macro_corpus_search",
        "toolDescription": "Semantic search (Supabase match_documents RPC) over macro indicators, sector notes and prior research.",
        "tableName": {
          "__rl": true,
          "value": "macro_documents",
          "mode": "list"
        },
        "topK": "={{ $('Workflow_Config').item.json.top_k }}",
        "options": {
          "queryName": "match_documents"
        }
      },
      "credentials": {
        "supabaseApi": {
          "id": "REPLACE_SUPABASE_CRED",
          "name": "Supabase account"
        }
      },
      "notes": "PRD 3.2 fix: orphaned vector store now reachable from the agent as a tool."
    },
    {
      "id": "n-mem",
      "name": "Context_Memory_Buffer",
      "type": "@n8n/n8n-nodes-langchain.memoryBufferWindow",
      "typeVersion": 1.3,
      "position": [
        -180,
        -120
      ],
      "parameters": {
        "sessionIdType": "customKey",
        "sessionKey": "={{ $('Bridge_Agent_Input').item.json.sessionId }}",
        "contextWindowLength": 10
      },
      "notes": "PRD 3.4 fix: attaches via ai_memory, not the webhook main path."
    },
    {
      "id": "n-llm",
      "name": "LLM_Inference_Engine",
      "type": "@n8n/n8n-nodes-langchain.lmChatAnthropic",
      "typeVersion": 1.3,
      "position": [
        -180,
        -360
      ],
      "parameters": {
        "model": {
          "__rl": true,
          "value": "={{ $('Workflow_Config').item.json.model }}",
          "mode": "id"
        },
        "options": {
          "maxTokensToSample": "={{ $('Workflow_Config').item.json.max_tokens }}",
          "temperature": 0
        }
      },
      "credentials": {
        "anthropicApi": {
          "id": "REPLACE_ANTHROPIC_CRED",
          "name": "Anthropic account"
        }
      },
      "notes": "PRD 3.2 fix: wired to the agent + retrieval tool via ai_languageModel."
    },
    {
      "id": "n-parser",
      "name": "Schema_Validation_Parser",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.2,
      "position": [
        40,
        -120
      ],
      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\n  \"type\": \"object\",\n  \"required\": [\n    \"theme\",\n    \"thesis\",\n    \"supporting_points\",\n    \"sectors_affected\",\n    \"confidence\"\n  ],\n  \"properties\": {\n    \"theme\": {\n      \"type\": \"string\"\n    },\n    \"thesis\": {\n      \"type\": \"string\"\n    },\n    \"supporting_points\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"required\": [\n          \"claim\",\n          \"source_ref\"\n        ],\n        \"properties\": {\n          \"claim\": {\n            \"type\": \"string\"\n          },\n          \"source_ref\": {\n            \"type\": \"string\"\n          }\n        }\n      }\n    },\n    \"sectors_affected\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"string\"\n      }\n    },\n    \"time_horizon\": {\n      \"enum\": [\n        \"0-6m\",\n        \"6-18m\",\n        \"18m+\"\n      ]\n    },\n    \"confidence\": {\n      \"type\": \"number\"\n    },\n    \"contradicting_evidence\": {\n      \"type\": [\n        \"string\",\n        \"null\"\n      ]\n    }\n  }\n}"
      }
    },
    {
      "id": "n-agent",
      "name": "NLP_Financial_Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.7,
      "position": [
        280,
        -120
      ],
      "parameters": {
        "promptType": "define",
        "text": "={{ $json.text }}",
        "options": {
          "systemMessage": "You generate grounded macro/sector research themes. ALWAYS ground claims by calling the macro_corpus_search tool; every supporting_point must cite a source_ref returned by that tool. If retrieval does not support a claim, drop it. Include contradicting_evidence when the corpus disagrees. Return only JSON matching the schema."
        }
      }
    },
    {
      "id": "n-flat",
      "name": "Flatten_Idea",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        500,
        -120
      ],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "f1",
              "name": "source_ref",
              "value": "={{ $('Bridge_Agent_Input').item.json.source_ref }}",
              "type": "string"
            },
            {
              "id": "f2",
              "name": "theme",
              "value": "={{ ($json.output ?? $json).theme }}",
              "type": "string"
            },
            {
              "id": "f3",
              "name": "thesis",
              "value": "={{ ($json.output ?? $json).thesis }}",
              "type": "string"
            },
            {
              "id": "f4",
              "name": "sectors_affected",
              "value": "={{ (($json.output ?? $json).sectors_affected || []).join(', ') }}",
              "type": "string"
            },
            {
              "id": "f5",
              "name": "time_horizon",
              "value": "={{ ($json.output ?? $json).time_horizon || '' }}",
              "type": "string"
            },
            {
              "id": "f6",
              "name": "confidence",
              "value": "={{ ($json.output ?? $json).confidence }}",
              "type": "number"
            },
            {
              "id": "f7",
              "name": "supporting_points_json",
              "value": "={{ JSON.stringify(($json.output ?? $json).supporting_points || []) }}",
              "type": "string"
            }
          ]
        },
        "includeOtherFields": false,
        "options": {}
      }
    },
    {
      "id": "n-ledger",
      "name": "Master_Ledger_Update",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        720,
        -120
      ],
      "parameters": {
        "operation": "append",
        "documentId": {
          "__rl": true,
          "value": "REPLACE_SHEET_ID",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "macro_ideas",
          "mode": "list"
        },
        "columns": {
          "mappingMode": "autoMapInputData"
        },
        "options": {}
      },
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "REPLACE_SHEETS_CRED",
          "name": "Google Sheets (ledger)"
        }
      }
    },
    {
      "id": "n-audit",
      "name": "Audit_Log_Write",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        940,
        -120
      ],
      "parameters": {
        "operation": "append",
        "documentId": {
          "__rl": true,
          "value": "REPLACE_SHEET_ID",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "audit_log",
          "mode": "list"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "ts": "={{ $now.toISO() }}",
            "workflow": "macro-thematic-ideation",
            "run_id": "={{ $execution.id }}",
            "action": "ledger_insert",
            "target": "={{ $json.source_ref }}",
            "reason": "={{ 'theme=' + $json.theme + ' confidence=' + $json.confidence }}",
            "actor": "system",
            "approved_by": "",
            "outcome": "success",
            "detail": ""
          }
        },
        "options": {}
      },
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "REPLACE_SHEETS_CRED",
          "name": "Google Sheets (ledger)"
        }
      }
    },
    {
      "id": "n-respond",
      "name": "Respond_To_Caller",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        1180,
        -120
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify($json) }}",
        "options": {}
      }
    },
    {
      "id": "n-errctx",
      "name": "Error_Context",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        280,
        140
      ],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "e1",
              "name": "ts",
              "value": "={{ $now.toISO() }}",
              "type": "string"
            },
            {
              "id": "e2",
              "name": "workflow",
              "value": "macro-thematic-ideation",
              "type": "string"
            },
            {
              "id": "e3",
              "name": "run_id",
              "value": "={{ $execution.id }}",
              "type": "string"
            },
            {
              "id": "e4",
              "name": "action",
              "value": "agent_failure",
              "type": "string"
            },
            {
              "id": "e5",
              "name": "target",
              "value": "={{ $('Bridge_Agent_Input').item.json.source_ref }}",
              "type": "string"
            },
            {
              "id": "e6",
              "name": "reason",
              "value": "={{ $json.error && $json.error.message ? $json.error.message : 'agent/parser error' }}",
              "type": "string"
            },
            {
              "id": "e7",
              "name": "actor",
              "value": "system",
              "type": "string"
            },
            {
              "id": "e8",
              "name": "approved_by",
              "value": "",
              "type": "string"
            },
            {
              "id": "e9",
              "name": "outcome",
              "value": "failed",
              "type": "string"
            },
            {
              "id": "e10",
              "name": "detail",
              "value": "={{ $json.error && $json.error.stack ? $json.error.stack : '' }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "n-erraudit",
      "name": "Error_Audit_Write",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        500,
        140
      ],
      "parameters": {
        "operation": "append",
        "documentId": {
          "__rl": true,
          "value": "REPLACE_SHEET_ID",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "audit_log",
          "mode": "list"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "ts": "={{ $json.ts }}",
            "workflow": "={{ $json.workflow }}",
            "run_id": "={{ $json.run_id }}",
            "action": "={{ $json.action }}",
            "target": "={{ $json.target }}",
            "reason": "={{ $json.reason }}",
            "actor": "system",
            "approved_by": "",
            "outcome": "failed",
            "detail": "={{ $json.detail }}"
          }
        },
        "options": {}
      },
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "REPLACE_SHEETS_CRED",
          "name": "Google Sheets (ledger)"
        }
      }
    },
    {
      "id": "n-erralert",
      "name": "Trigger_Executive_Alert",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.3,
      "position": [
        720,
        140
      ],
      "parameters": {
        "resource": "message",
        "operation": "post",
        "select": "channel",
        "channelId": {
          "__rl": true,
          "value": "REPLACE_SLACK_CHANNEL",
          "mode": "id"
        },
        "text": "=macro-thematic-ideation run {{ $json.run_id }} failed: {{ $json.reason }}",
        "otherOptions": {}
      },
      "credentials": {
        "slackApi": {
          "id": "REPLACE_SLACK_CRED",
          "name": "Slack account"
        }
      }
    }
  ],
  "connections": {
